{
  "name": "ProxyDisc — Drive Disc Rating Tool",
  "short_name": "ProxyDisc",
  "description": "Grade Zenless Zone Zero drive discs for every agent: keep, level or recycle.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0c0e",
  "theme_color": "#0b0c0e",
  "icons": [
    { "src": "/assets/app-icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/app-icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/app-icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Scrap or stash", "short_name": "Rate a disc", "url": "/#scrap-or-stash" },
    { "name": "Loadouts", "url": "/#loadouts" },
    { "name": "My discs", "url": "/#my-discs" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "screenshot", "accept": ["image/png", "image/jpeg", "image/webp", "image/*"] }] }
  }
}
