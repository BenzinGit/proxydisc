# Cache rules, read by Cloudflare Pages and Netlify (other hosts ignore this file).
# Everything in /assets is either stamped with a content hash (?v=...) by build.mjs or never
# changes (the fonts), so browsers can keep it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker has to be re-checked on every visit or site updates stall.
/sw.js
  Cache-Control: no-cache
